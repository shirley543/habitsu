# Copy to .env and fill in real values.
# Required to run `cdk synth`/`cdk deploy` for ReminderStack (see lib/reminder-stack.ts).
# Note: QUEUE_URL is not listed here - it's derived automatically from the SQS
# queue CDK creates, not something we set ourselves.

# PostgreSQL connection string reminder-finder uses to query due goals
DATABASE_URL=postgresql://user:password@localhost:5432/habit_tracker

# SES-verified sender address reminder-worker sends reminder emails from
FROM_EMAIL=reminders@yourdomain.com
