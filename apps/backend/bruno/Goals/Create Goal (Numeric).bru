meta {
  name: Create Goal (Numeric)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/goals
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "Drink water",
    "description": "Drink at least 2 litres of water a day",
    "icon": "droplet",
    "colour": "3498db",
    "publicity": "PUBLIC",
    "visibility": true,
    "goalType": "NUMERIC",
    "numericTarget": 2,
    "numericUnit": "litres"
  }
}

docs {
  Requires the `jwt` cookie set by Auth > Login.

  `colour` must be a 6-digit hex string (no leading #).
  `publicity` is one of "PUBLIC" | "PRIVATE".
}
