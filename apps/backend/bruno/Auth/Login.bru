meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "alice@alice.com",
    "password": "strongpassword123"
  }
}

docs {
  Logs in with email + password.

  On success, sets an httpOnly `jwt` cookie which Bruno stores and sends
  automatically with subsequent requests in this collection.
}
