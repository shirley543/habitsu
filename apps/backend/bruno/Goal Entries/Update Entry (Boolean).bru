meta {
  name: Update Entry (Boolean)
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/goals/:goalId/entries/:entryId
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

params:path {
  goalId: 1
  entryId: 1
}

body:json {
  {
    "note": "Updated note"
  }
}

docs {
  Requires the `jwt` cookie set by Auth > Login. All fields are optional.

  For BOOLEAN goals. `numericValue` does not apply.
}
